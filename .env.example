# Copy to .env (next to docker-compose.yml) and adjust.

# development: demo users/data are seeded; production: refuses insecure defaults
ENVIRONMENT=development
# Required in production: at least 32 random characters, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Browser origins allowed to call the API (comma-separated, never * in production)
CORS_ORIGINS=http://localhost:3000
# URL the browser uses to reach the API (baked into the frontend build)
PUBLIC_API_URL=http://localhost:8080/api/v1
SEED_DEMO_DATA=true

# First administrator, created on startup when the database has no users (recommended for production)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

POSTGRES_DB=parakhmaan
POSTGRES_USER=parakhmaan
POSTGRES_PASSWORD=change-me
# Object storage (bundled RustFS; point S3_ENDPOINT_URL at AWS S3 / another S3 service to use that instead)
S3_ACCESS_KEY=parakhmaan
S3_SECRET_KEY=change-me-s3-secret
S3_BUCKET=parakhmaan
S3_ENDPOINT_URL=http://objectstore:9000

DEFECT_DETECTOR_BACKEND=hybrid
DEFECT_MODEL_CLASSES=scratch,crack,dent,discolouration

# Edge node (docker compose --profile edge up -d edge); key comes from Admin -> Edge Devices
EDGE_DEVICE_KEY=
EDGE_CENTRAL_URL=http://api:8000
